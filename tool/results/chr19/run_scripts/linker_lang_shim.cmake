# Configure-time shim for STPD-index 8a432a4 with CMake 3.31: its header-only OBJECT libraries have no linker
# language, which CMake rejects. After the whole project is configured, give every such target LINKER_LANGUAGE CXX.
function(_stpd_set_linker_lang dir)
  get_property(ts DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(t IN LISTS ts)
    get_target_property(ty ${t} TYPE)
    if(NOT ty STREQUAL "INTERFACE_LIBRARY")
      get_target_property(ll ${t} LINKER_LANGUAGE)
      if(NOT ll)
        set_target_properties(${t} PROPERTIES LINKER_LANGUAGE CXX)
      endif()
    endif()
  endforeach()
  get_property(subs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(s IN LISTS subs)
    _stpd_set_linker_lang("${s}")
  endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _stpd_set_linker_lang "${CMAKE_SOURCE_DIR}")
